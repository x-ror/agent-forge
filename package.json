{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm -r build && pnpm lint && pnpm format:check && pnpm -r typecheck && pnpm -r test",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev": "pnpm dev:infra && pnpm -r --parallel dev"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "argon2",
      "sass-embedded",
      "unrs-resolver",
      "protobufjs",
      "cpu-features",
      "ssh2"
    ]
  }
}
