{
  "name": "agentforge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm -r build && pnpm lint && pnpm -r typecheck && pnpm -r test",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev": "pnpm dev:infra && pnpm -r --parallel dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "argon2",
      "sass-embedded",
      "unrs-resolver",
      "protobufjs",
      "cpu-features",
      "ssh2"
    ]
  }
}
