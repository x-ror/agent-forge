server {
  listen 3000;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Re-resolve the api container on each request via Docker's embedded DNS —
  # a static proxy_pass pins the IP at startup and 502s after `up -d api`.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_origin ${API_ORIGIN};

  # Single public origin: the SPA and the api share :3000 — no CORS surface (§12).
  location /api/v1/ {
    proxy_pass $api_origin;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # SSE must stream through unbuffered (§9).
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location / {
    try_files $uri /index.html;
  }
}
