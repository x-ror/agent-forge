# Copy to .env before `docker compose up`.
# The same file is picked up by the api/worker when you run them locally
# (real environment variables always win over values from this file).

# ---- docker compose (production) -------------------------------------------

# Postgres superuser password (admin/migration connection).
POSTGRES_PASSWORD=change-me

# App-role password; the first migration creates the role with this password.
AGENTFORGE_APP_DB_PASSWORD=change-me-too

# 32 bytes, base64 — encrypts project secrets at rest.
# Generate with:  openssl rand -base64 32
AGENTFORGE_SECRET_KEY=

# Redis password (enforced via requirepass in both compose files when set).
REDIS_PASSWORD=change-me-three

# Sandbox driver: process (default, works everywhere) or docker.
SANDBOX_DRIVER=process

# ---- local development (pnpm dev against docker-compose.dev.yml) -----------
# Uncomment to override the built-in dev defaults.

# NOTE: dotenv files do not expand ${VAR} references — paste the same
# passwords as above literally into these URLs:
# DATABASE_URL=postgres://agentforge_app:<AGENTFORGE_APP_DB_PASSWORD>@localhost:5432/agentforge
# DATABASE_ADMIN_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5432/agentforge
# REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379
# API_PORT=3001
# WORKSPACES_DIR=/tmp/agentforge/workspaces
# ARTIFACTS_DIR=/tmp/agentforge/artifacts
# AGENT_MAX_CONCURRENT_RUNS=3
# SANDBOX_NETWORK_DEFAULT=full
# LOG_LEVEL=info

# Point the server at a specific env file instead of ./.env:
# AGENTFORGE_ENV_FILE=/path/to/custom.env
