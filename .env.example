# Copy to .env before `docker compose up`.

# Postgres superuser password (admin/migration connection).
POSTGRES_PASSWORD=change-me

# App-role password; the first migration creates the role with this password.
AGENTFORGE_APP_DB_PASSWORD=change-me-too

# 32 bytes, base64 — encrypts project secrets at rest.
# Generate with:  openssl rand -base64 32
AGENTFORGE_SECRET_KEY=

# Sandbox driver: process (default, works everywhere) or docker.
SANDBOX_DRIVER=process
